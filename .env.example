NODE_ENV=production
APP_URL=https://hcd.example.com
RENDER_URL=https://hcd-render.example.com
PORT=3000
DATA_DIR=./data
# Set a unique random value before production deployment.
SECRET_KEY=replace-this-with-a-long-random-secret

# Optional email notifications; leave both unset to keep mail delivery disabled.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM=HCD <notifications@example.com>
# SMTP_USER=notifications@example.com
# SMTP_PASS=
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true

# Daily review summary: one email after this local hour (0-23).
# MAIL_DIGEST_TIMEZONE=Asia/Taipei
# MAIL_DIGEST_HOUR=9

# Space owners configure encrypted bot credentials in workspace settings.
# FEISHU_BASE_URL=https://open.feishu.cn
# For Lark, use https://open.larksuite.com instead.

# Optional internal-only PDF service; built by deploy/Dockerfile.exporter.
# EXPORTER_URL=http://exporter:4000
