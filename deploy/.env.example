# Public DNS names for this server; point both at the Docker host.
APP_HOST=app.example.com
RENDER_HOST=render.example.com

# APP_URL must be the public HTTPS origin used by the session/origin guard.
APP_URL=https://app.example.com
RENDER_URL=https://render.example.com

# Generate locally with: openssl rand -hex 32
SECRET_KEY=

# Demo users and documents are disabled by default in production.
# Production startup rejects HCD_SEED_DEMO=1. Use a non-production instance for demos.
HCD_SEED_DEMO=0

# Optional SMTP delivery (TLS required by default).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM=HCD <notifications@example.com>
# SMTP_USER=notifications@example.com
# SMTP_PASS=
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true

# Daily review summary: one email after this local hour (0-23).
# MAIL_DIGEST_TIMEZONE=Asia/Taipei
# MAIL_DIGEST_HOUR=9

# Space owners configure encrypted bot credentials in workspace settings.
# FEISHU_BASE_URL=https://open.feishu.cn
# For Lark, use https://open.larksuite.com instead.

# Compose connects the app to its private PDF exporter automatically.

# Comma-separated trusted proxy IPs/CIDRs. Match the Compose default subnet.
# For direct access outside Compose leave unset; never trust every address.
TRUST_PROXY=172.28.0.0/24

# Structured request log verbosity; tests are silent by default.
LOG_LEVEL=info
