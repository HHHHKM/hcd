{
  "name": "hcd",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "dev:server": "tsx watch packages/server/src/main.ts",
    "start": "tsx packages/server/src/main.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint packages/web/src src && node scripts/security-check.mjs && node scripts/check-contrast.mjs",
    "seed:demo": "tsx packages/server/src/cli.ts seed demo",
    "hcd": "tsx packages/server/src/cli.ts",
    "mdoc": "tsx packages/cli/src/index.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:visual": "pnpm build && playwright test -c playwright.visual.config.ts",
    "test:visual:update": "pnpm build && playwright test -c playwright.visual.config.ts --update-snapshots",
    "format": "prettier --write packages/web src"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "9.2.1",
    "@fastify/static": "^8.2.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@noble/hashes": "^2.0.1",
    "@tiptap/core": "^3.5.0",
    "@tiptap/pm": "^3.5.0",
    "@tiptap/react": "^3.5.0",
    "@tiptap/starter-kit": "^3.5.0",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.6.0",
    "fflate": "^0.8.2",
    "i18next": "^25.5.2",
    "kysely": "^0.28.8",
    "nodemailer": "^7.0.6",
    "parse5": "^7.3.0",
    "pg": "^8.16.3",
    "pino": "^9.9.4",
    "playwright": "1.64.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^16.6.6",
    "react-router": "^8.5.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.5.2",
    "@types/nodemailer": "^7.0.1",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.3.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
